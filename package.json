{
  "name": "agent-arena",
  "private": true,
  "version": "0.1.0",
  "description": "DEGEN VILLAGE — isometric village where AI agents train in buildings and trade memecoins from a terminal.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sim": "MODE=sim tsx src/run.ts",
    "live": "MODE=live tsx src/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "chain": "tsx scripts/chain-probe.ts",
    "paper": "MODE=paper tsx src/run.ts",
    "paper:chain": "MODE=chain-demo tsx src/run.ts",
    "paper:check": "tsx scripts/paper-check.ts",
    "nft:build": "tsx scripts/nft/build.ts",
    "nft:prepare": "tsx scripts/nft/prepare.ts",
    "nft:activate": "tsx scripts/nft/activate.ts",
    "nft:deploy": "tsx scripts/nft/deploy.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "solc": "0.8.37",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
